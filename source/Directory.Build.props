<Project>
  <!-- Import parent Directory.Build.props -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Default package metadata (can be overridden in individual projects) -->
  <PropertyGroup Label="Package Metadata">
    <Authors>Steven T. Cramer</Authors>
    <Product>TimeWarp.Build.Tasks</Product>
    <PackageVersion>1.0.0-beta.1</PackageVersion>
    <PackageProjectUrl>https://timewarpengineering.github.io/timewarp-build-tasks/</PackageProjectUrl>
    <PackageIcon>logo.png</PackageIcon>
    <RepositoryUrl>https://github.com/TimeWarpEngineering/timewarp-build-tasks.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
    <PackageReleaseNotes>
      For detailed release notes and changelog, please visit: https://github.com/TimeWarpEngineering/timewarp-build-tasks/releases
    </PackageReleaseNotes>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Label="Source Link Configuration">
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- MSBuild and NuGet behavior configuration -->
  <PropertyGroup Label="MSBuild/NuGet Configuration">
    <!-- Enable package generation on build -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

    <!-- Output packages to our local feed directory -->
    <PackageOutputPath>$(LocalNuGetFeed)</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(RepositoryRoot)assets/logo.png" Pack="true" PackagePath="/"/>
    <None Include="$(MSBuildThisFileDirectory)readme.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
