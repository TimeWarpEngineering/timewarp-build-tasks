<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Assembly and Package Settings -->
    <AssemblyName>TimeWarp.Build.Tasks</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>TimeWarp.Build.Tasks</PackageId>
    <Description>MSBuild tasks for TimeWarp projects including git metadata injection and build automation</Description>
    <PackageTags>msbuild;git;metadata;build;timewarp</PackageTags>

    <!-- Prevent the DLL from being added as a lib reference -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>

    <!-- Disable symbol package for MSBuild task packages -->
    <IncludeSymbols>false</IncludeSymbols>

    <GenerateDependencyFile>false</GenerateDependencyFile>

    <!-- RS0030: git-metadata-task runs git via ProcessStartInfo, which BannedSymbols.txt bans in favor of TimeWarp.Amuru. Amuru is deliberately not used here: this package supplies build tasks that other TimeWarp builds consume, so depending on Amuru could create an indirect circular dependency. The suppression is accepted in .timewarp/suppression-baseline.json. Task 006. -->
    <NoWarn>$(NoWarn);RS0030</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The root Directory.Build.props (ganda audit baseline) adds TimeWarp.Build.Tasks to every project; this project IS that package, so referencing itself is a restore cycle (NU1108). -->
    <PackageReference Remove="TimeWarp.Build.Tasks" />
    <PackageReference Include="Microsoft.Build.Framework" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" PrivateAssets="all" />
  </ItemGroup>

  <!-- Package the task DLL in both build and buildTransitive folders -->
  <ItemGroup>
    <!-- Package DLL in both build and buildTransitive -->
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="build/net11.0" />
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="buildTransitive/net11.0" />

    <!-- Package props in both folders. On disk the file is kebab-case; NuGet only auto-imports build/<PackageId>.props, so PackagePath pins the exact PackageId casing. -->
    <None Include="build/timewarp-build-tasks.props" Pack="true" PackagePath="build/TimeWarp.Build.Tasks.props" />
    <None Include="build/timewarp-build-tasks.props" Pack="true" PackagePath="buildTransitive/TimeWarp.Build.Tasks.props" />
  </ItemGroup>

</Project>
