<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- Microsoft Build Tools. Compile-time only (PrivateAssets=all, not packed).
         Must not be newer than the MSBuild in the minimum supported SDK: a task built
         against a newer MSBuild fails to load. .NET SDK 11.0.100 ships MSBuild 18.12.2. Task 010. -->
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.12.2" />
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.12.2" />
    
    <!-- SourceLink for deterministic builds -->
    
  <PackageVersion Include="TimeWarp.Build.Tasks" Version="2.0.0" /><PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0"><PrivateAssets>all</PrivateAssets><IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets></PackageVersion><PackageVersion Include="TimeWarp.Nuru" Version="4.0.0-beta.13" /><PackageVersion Include="TimeWarp.Amuru" Version="3.0.0-beta.2" /><PackageVersion Include="TimeWarp.Amuru.Tools" Version="3.0.0-beta.2" /><PackageVersion Include="TimeWarp.Terminal" Version="2.0.0-beta.1" /><PackageVersion Include="TimeWarp.Nuru.DevCli" Version="4.0.0-beta.13" /></ItemGroup>
</Project>
